@model OdaTipi
@{ ViewData["Title"] = "Oda Tipi Ekle"; }

<h2>Oda Tipi Ekle</h2>
<form method="post">
    <label>Tip Adi</label>
    <input asp-for="TipAdi" class="form-control mb-3" required />
    <label>Aylik Ucret</label>
    <input asp-for="AylikUcret" class="form-control mb-3" required />
    <button class="btn btn-primary">Kaydet</button>
    <a class="btn btn-secondary" asp-action="Index">Geri</a>
</form>
