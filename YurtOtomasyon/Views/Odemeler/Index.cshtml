@model List<Odeme>
@{ ViewData["Title"] = "Odemeler"; }

<h2>Odemeler</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Yeni Odeme</a>

<table class="table table-bordered table-sm">
    <tr><th>ID</th><th>Ogrenci</th><th>Tutar</th><th>Tarih</th><th>Aciklama</th><th>Islem</th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.OdemeID</td>
            <td>@item.OgrenciAdSoyad</td>
            <td>@item.Tutar</td>
            <td>@item.OdemeTarihi.ToShortDateString()</td>
            <td>@item.Aciklama</td>
            <td>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.OdemeID">Duzenle</a>
                <form asp-action="Delete" asp-route-id="@item.OdemeID" method="post" class="d-inline">
                    <button class="btn btn-sm btn-danger">Sil</button>
                </form>
            </td>
        </tr>
    }
</table>
